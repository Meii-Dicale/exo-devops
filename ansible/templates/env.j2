# {{ ansible_managed | default('Généré par Ansible') }} : ne pas modifier à la main.
# Modèle : .env.example à la racine du dépôt. deploy.sh refuse un .env auquel il
# manque une de ses clés : une clé ajoutée là doit l'être ici aussi.

# --- Base de données ---------------------------------------------------------
POSTGRES_PASSWORD={{ postgres_password }}
DATABASE_URL=postgres://taskflow:{{ postgres_password }}@db:5432/taskflow

# --- API ---------------------------------------------------------------------
APP_ENV={{ app_env }}

# --- Images ------------------------------------------------------------------
GHCR_OWNER={{ ghcr_owner }}
# deploy.sh exporte la version déployée : cette valeur ne sert qu'à docker compose lancé à la main.
IMAGE_TAG={{ image_tag }}

# --- Ports -------------------------------------------------------------------
HTTP_PORT={{ http_port }}
HTTPS_PORT={{ https_port }}
FRONT_PORT={{ front_port }}
